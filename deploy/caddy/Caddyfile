{
	admin off
	local_certs
	auto_https disable_redirects
	http_port 8080
	https_port 8443
}

# Internal-only liveness endpoint for the container healthcheck (not published).
:8081 {
	respond /health 200
}

https://{$KAGEBOX_HOST:localhost}:8443 {
	encode zstd gzip
	# Bodies: 210 MB only for the multipart upload routes (chapter source, rights evidence),
	# 1 MB everywhere else, so no large body reaches a route that parses it before auth.
	# The API enforces the same split itself (apps/api/kagebox_api/limits.py).
	@uploads {
		method POST
		path_regexp ^/api/(chapters/[^/]+/upload|projects/[^/]+/rights)$
	}
	@not_uploads {
		not {
			method POST
			path_regexp ^/api/(chapters/[^/]+/upload|projects/[^/]+/rights)$
		}
	}
	request_body @uploads {
		max_size 210MB
	}
	request_body @not_uploads {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output stdout
		format json
	}
}
