# Copy to .env (make env). No secrets here: secrets live in deploy/secrets/*.txt (make secrets).
# Hostname and port Caddy serves on. The port is bound to 127.0.0.1 only.
KAGEBOX_HOST=localhost
KAGEBOX_PORT=8443
# cloud (default, Together AI for generation) or gpu (adds worker-gpu)
KAGEBOX_PROFILE=cloud
