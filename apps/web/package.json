{
  "name": "kagebox-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "tokens": "node scripts/tokens-to-css.mjs ../../docs/design/tokens.json src/app/tokens.css",
    "tokens:check": "node scripts/tokens-to-css.mjs ../../docs/design/tokens.json src/app/tokens.css --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
